%% PhysGS: Bayesian-Inferred Gaussian Splatting for Physical Property Estimation
%% presentation panorama — CVPR 2026 (arXiv:2511.18570)
flowchart TD
    T["PhysGS: Bayesian-Inferred Gaussian Splatting for Physical Property Estimation"]

    subgraph SG_IN["Input"]
        IN1["Multi-view RGB Images (N views of same scene)"]
        IN2["GPT-5 VLM (vision-language prior)"]
    end

    subgraph SG_SEG["Segmentation (SAM)"]
        SAM1["Whole / Part / Sub-part masks (per view)"]
        SAM2["IoU + stability filtering"]
    end

    subgraph SG_VLM["VLM Prompting (GPT-5)"]
        VP1["3-image triplet: full + mask overlay + isolated part"]
        VP2["caption · material · property · confidence p in [0,1]"]
        VP3["Observation O_m = (c_m, p_m, ψ_m)"]
    end

    subgraph SG_BAYES["Bayesian Inference over Splats (hierarchical: p(z,ψ|Z)=p(ψ|z)·p(z|Z))"]
        B1["1 · Dirichlet-Categorical: ᾱᵢ = αᵢ(0) + Σ λ·pₘ  →  material posterior wᵢ = ᾱᵢ/Σᾱⱼ"]
        B2["2 · Confidence-weighted moments: W=Σp, S=Σpψ, Q=Σpψ²  →  μᵢ=S/W, σᵢ²=Q/W−μᵢ²"]
        B3["3 · NIG prior: aleatoric=β̃/(ᾱ−1), epistemic=E[σ²]/κ̃"]
        B4["Gaussian Mixture (Eq. 11): f(ψ|Z,α) = Σᵢ (ᾱᵢ/Σⱼᾱⱼ)·N(μᵢ,σᵢ²)  →  MMSE = Σ wᵢμᵢ"]
        B5["streaming: O(1) closed-form updates · no history · cross-view fusion by material-name grouping"]
    end

    subgraph SG_GS["Semantic 3DGS (per-material properties propagated to points)"]
        GS1["Material legend recolor: each material → unique color"]
        GS2["Splat training: splatfacto-big (Nerfstudio), 20K iter, RTX A5000"]
        GS3["Per-point query: point → material class → property (friction/hardness/density)"]
        GS4["Volume integral: integrate density over volume → object mass"]
    end

    subgraph SG_OUT["Outputs"]
        O1["Per-point friction / hardness / stiffness / density"]
        O2["Object mass"]
        O3["Aleatoric + epistemic uncertainty"]
    end

    subgraph SG_USE["For Our Project"]
        U1["Friction → PMAT__muXXX profiles"]
        U2["Epistemic map → where to measure friction physically"]
        U3["Complements GaussGym scene pipeline"]
    end

    T --> IN1
    IN1 --> SAM1
    SAM1 --> SAM2
    SAM2 --> VP1
    VP1 --> VP2
    VP2 --> VP3
    IN2 -.-> VP2
    VP3 --> B1
